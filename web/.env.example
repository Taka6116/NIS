# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Credentials login (email + password or bcrypt hash)
AUTH_EMAIL=
AUTH_PASSWORD=

# OAuth (NextAuth Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google APIs — prefer env-only credentials (do NOT commit raw JSON files)
# Single-line JSON or use GOOGLE_APPLICATION_CREDENTIALS for local file path
GOOGLE_SERVICE_ACCOUNT_JSON=

# GA4 numeric Property ID (管理 > プロパティの詳細). NOT ストリームID, NOT Measurement ID (G-xxxxx).
GA4_PROPERTY_ID=

# Microsoft Clarity (project-level tokens may also be stored per project in DynamoDB)
CLARITY_API_TOKEN=
CLARITY_PROJECT_ID=

# Gemini
GEMINI_API_KEY=
# Optional override (default gemini-2.0-flash)
# GEMINI_MODEL=

# Claude insight pipeline (Analyze with Claude): Amazon Bedrock direct invoke.
# Requires `bedrock:InvokeModel` on the AWS credentials above and Model access enabled in Bedrock console.
# Use an inference profile ID for cross-region profiles.
# Tokyo (ap-northeast-1): jp.anthropic.claude-sonnet-4-5-20250929-v1:0
# Global (any source region): global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=

# AWS DynamoDB
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Table names (override defaults in lib/dynamodb/tables.ts)
NIS_TABLE_PROJECTS=nis-projects
NIS_TABLE_GSC_DAILY=nis-gsc-daily
NIS_TABLE_GA4_DAILY=nis-ga4-daily
NIS_TABLE_CLARITY_DAILY=nis-clarity-daily
NIS_TABLE_INSIGHTS=nis-insights
NIS_TABLE_USERS=nis-users

# Default project (auto-created on first login if set)
NIS_DEFAULT_PROJECT_NAME=日本提携支援
NIS_DEFAULT_DOMAIN=nihon-teikei.co.jp
NIS_DEFAULT_GSC_PROPERTY_URL=https://nihon-teikei.co.jp/
# Same as GA4_PROPERTY_ID for single-tenant: プロパティの詳細の「プロパティID」（画像のストリームIDとは別）
NIS_DEFAULT_GA4_PROPERTY_ID=
# NIS_DEFAULT_CLARITY_PROJECT_ID=

# Cron & webhooks
CRON_SECRET=
SLACK_WEBHOOK_URL=

# Optional: comma-separated admin emails (full access + /admin/users)
NIS_ADMIN_EMAILS=you@example.com

# Dev: skip DynamoDB and use in-memory store (not for production)
# NIS_USE_MOCK_DB=1

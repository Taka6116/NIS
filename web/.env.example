# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Credentials login (email + password or bcrypt hash)
AUTH_EMAIL=
AUTH_PASSWORD=

# OAuth (NextAuth Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google APIs
# 本番: GOOGLE_SERVICE_ACCOUNT_JSON に1行のJSON文字列を設定する
# ローカル開発: GOOGLE_APPLICATION_CREDENTIALS にサービスアカウントJSONファイルのパスを設定可（本番では使わない）
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # ローカルのみ

# GA4 numeric Property ID (管理 > プロパティの詳細). NOT ストリームID, NOT Measurement ID (G-xxxxx).
GA4_PROPERTY_ID=

# Microsoft Clarity (project-level tokens may also be stored per project in DynamoDB)
CLARITY_API_TOKEN=
CLARITY_PROJECT_ID=

# Gemini
GEMINI_API_KEY=
# Optional override (default gemini-2.0-flash)
# GEMINI_MODEL=

# Claude insight pipeline (Analyze with Claude): Amazon Bedrock direct invoke.
# Requires `bedrock:InvokeModel` on the AWS credentials above and Model access enabled in Bedrock console.
# Tokyo (ap-northeast-1): jp.anthropic.claude-sonnet-4-5-20250929-v1:0
# Global (any source region): global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=

# AWS 認証情報 (DynamoDB, S3, Bedrock)
# IAM 権限: dynamodb:*, s3:GetObject, s3:PutObject, s3:DeleteObject, s3:ListBucket, bedrock:InvokeModel
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB テーブル名（デフォルト値 = lib/dynamodb/tables.ts の定数と同じ）
NIS_TABLE_PROJECTS=nis-projects
NIS_TABLE_GSC_DAILY=nis-gsc-daily
NIS_TABLE_GA4_DAILY=nis-ga4-daily
NIS_TABLE_CLARITY_DAILY=nis-clarity-daily
NIS_TABLE_INSIGHTS=nis-insights
NIS_TABLE_USERS=nis-users
# 打ち手トラッキング (B1)
NIS_TABLE_ACTION_TRACKING=nis-action-tracking
# アラート設定 (B8)
NIS_TABLE_PROJECT_ALERTS=nis-project-alerts
# インサイト共有トークン (B7)
NIS_TABLE_INSIGHT_SHARES=nis-insight-shares

# S3 バケット名
# キーワードデータセット（Ahrefs CSV アップロード用）
NIS_S3_BUCKET_KW_DATASETS=nis-kw-datasets

# Default project (auto-created on first login if set)
NIS_DEFAULT_PROJECT_NAME=日本提携支援
NIS_DEFAULT_DOMAIN=nihon-teikei.co.jp
NIS_DEFAULT_GSC_PROPERTY_URL=https://nihon-teikei.co.jp/
# Same as GA4_PROPERTY_ID for single-tenant
NIS_DEFAULT_GA4_PROPERTY_ID=
# NIS_DEFAULT_CLARITY_PROJECT_ID=

# Cron & webhooks
CRON_SECRET=
SLACK_WEBHOOK_URL=

# 管理者メール（カンマ区切り）。これ以外の新規 OAuth ユーザーは viewer として登録される。
# member/admin への昇格は /admin/users で管理者が手動で行う。
NIS_ADMIN_EMAILS=you@example.com

# Dev: skip DynamoDB and use in-memory store (not for production)
# NIS_USE_MOCK_DB=1

# Dev: skip OAuth and auto-login as dev@nis.local (not for production)
# NIS_DEV_BYPASS_AUTH=1
